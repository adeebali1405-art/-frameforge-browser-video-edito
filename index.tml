<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FrameForge – Browser Video Editor</title>
<style>
:root{--bg:#0d0f14;--panel:#151922;--panel2:#1c2130;--line:#2a3042;--tx:#e8ecf4;--mut:#8a93a8;--ac:#6c8cff;--ac2:#a06cff;--ok:#38d39f;--bad:#ff5d73;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#eef1f7;--panel:#fff;--panel2:#f2f4fa;--line:#d9deea;--tx:#161a26;--mut:#5d667c;color-scheme:light}}
*{box-sizing:inherit;margin:0}
html,body{height:100%}
body{background:var(--bg);color:var(--tx);font:14px/1.4 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;display:flex;flex-direction:column;overflow:hidden}
header{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--panel);border-bottom:1px solid var(--line)}
.logo{font-weight:800;letter-spacing:.3px;background:linear-gradient(90deg,var(--ac),var(--ac2));-webkit-background-clip:text;background-clip:text;color:transparent;font-size:17px}
.sp{flex:1}.fn{color:var(--mut);font-size:12px;max-width:30vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
button,select,input[type=text]{font:inherit;color:var(--tx);background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:7px 12px;cursor:pointer}
button:hover:not(:disabled){border-color:var(--ac)}button:disabled{opacity:.4;cursor:not-allowed}
.pri{background:linear-gradient(90deg,var(--ac),var(--ac2));border:0;color:#fff;font-weight:600}
main{flex:1;min-height:0;display:grid;grid-template-columns:1fr 320px}
.stage{display:flex;flex-direction:column;min-width:0;min-height:0;padding:12px;gap:10px}
.view{flex:1;min-height:0;background:#000;border-radius:12px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
canvas{max-width:100%;max-height:100%;display:block}
.drop{position:absolute;inset:0;display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;color:#cfd6e6;text-align:center;background:rgba(10,12,18,.92);cursor:pointer}
.drop.hide{display:none}.drop b{font-size:18px}.drop span{color:var(--mut)}
.drop.over{outline:2px dashed var(--ac);outline-offset:-12px}
.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tc{font-variant-numeric:tabular-nums;font-family:ui-monospace,Menlo,monospace;color:var(--mut)}
.tc b{color:var(--tx);font-weight:600}
side{display:flex;flex-direction:column;background:var(--panel);border-left:1px solid var(--line);min-height:0}
.tabs{display:flex;border-bottom:1px solid var(--line)}
.tabs button{flex:1;border:0;border-radius:0;background:none;color:var(--mut);padding:11px 4px;border-bottom:2px solid transparent}
.tabs button.on{color:var(--tx);border-bottom-color:var(--ac)}
.pane{display:none;padding:14px;overflow:auto;flex:1}.pane.on{display:block}
.row{margin-bottom:12px}.row label{display:flex;justify-content:space-between;color:var(--mut);font-size:12px;margin-bottom:4px}
.row label output{color:var(--tx);font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--ac)}
.presets{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px}
.presets button.on{border-color:var(--ac);background:color-mix(in srgb,var(--ac) 18%,var(--panel2))}
.tl{background:var(--panel);border-top:1px solid var(--line);padding:10px 16px 14px}
.track{position:relative;height:64px;margin-top:4px;border-radius:8px;background:var(--panel2);border:1px solid var(--line);touch-action:none;cursor:pointer;overflow:hidden}
.thumbs{position:absolute;inset:0;display:flex}.thumbs img{flex:1;min-width:0;height:100%;object-fit:cover;opacity:.85}
.shade{position:absolute;top:0;bottom:0;background:rgba(5,7,12,.72);pointer-events:none}
.sel{position:absolute;top:0;bottom:0;border-top:3px solid var(--ac);border-bottom:3px solid var(--ac);pointer-events:none}
.h{position:absolute;top:0;bottom:0;width:14px;background:var(--ac);cursor:ew-resize;display:flex;align-items:center;justify-content:center;z-index:2}
.h::after{content:"";width:2px;height:22px;background:#fff;border-radius:2px}
.ph{position:absolute;top:-4px;bottom:-4px;width:2px;background:#fff;z-index:3;pointer-events:none;box-shadow:0 0 6px rgba(0,0,0,.6)}
.ph::before{content:"";position:absolute;top:0;left:-5px;border:6px solid transparent;border-top-color:#fff;border-bottom:0}
.ruler{position:relative;height:16px;color:var(--mut);font-size:10px}
.ruler i{position:absolute;top:0;border-left:1px solid var(--line);padding-left:3px;height:16px;font-style:normal}
.prog{height:8px;background:var(--panel2);border-radius:99px;overflow:hidden;margin:10px 0}
.prog div{height:100%;width:0;background:linear-gradient(90deg,var(--ac),var(--ac2))}
.note{color:var(--mut);font-size:12px}kbd{background:var(--panel2);border:1px solid var(--line);border-radius:4px;padding:0 5px;font-size:11px}
a.dl{display:none;margin-top:10px;text-align:center;text-decoration:none;color:#fff;padding:10px;border-radius:8px;background:var(--ok);font-weight:600}
@media(max-width:860px){main{grid-template-columns:1fr;grid-template-rows:1fr 260px}side{border-left:0;border-top:1px solid var(--line)}.fn{display:none}}
</style>
</head>
<body>
<header>
  <span class="logo">◆ FrameForge</span><span class="fn" id="fn">No file loaded</span><span class="sp"></span>
  <button id="open">Import video</button>
  <button class="pri" id="exp" disabled>Export</button>
  <input type="file" id="file" accept="video/*" hidden>
</header>
<main>
  <div class="stage">
    <div class="view">
      <canvas id="cv" width="1280" height="720"></canvas>
      <div class="drop" id="drop"><b>Drop a video here</b><span>or click to browse · MP4, WebM, MOV · processed 100% on your device</span></div>
    </div>
    <div class="bar">
      <button id="play" disabled>▶ Play</button>
      <button id="setIn" disabled title="I">Set In</button>
      <button id="setOut" disabled title="O">Set Out</button>
      <button id="reset" disabled>Reset trim</button>
      <span class="sp"></span>
      <span class="tc"><b id="cur">0:00.0</b> / <span id="tot">0:00.0</span> · clip <b id="clip">0:00.0</b></span>
    </div>
  </div>
  <side>
    <div class="tabs"><button class="on" data-t="f">Filters</button><button data-t="a">Adjust</button><button data-t="t">Text</button><button data-t="e">Export</button></div>
    <div class="pane on" id="p-f"><div class="presets" id="presets"></div><div id="fs"></div></div>
    <div class="pane" id="p-a"><div id="as"></div><p class="note">Shortcuts: <kbd>Space</kbd> play · <kbd>I</kbd>/<kbd>O</kbd> set in/out · <kbd>←</kbd>/<kbd>→</kbd> step 1 frame · <kbd>Shift</kbd>+arrows 1s</p></div>
    <div class="pane" id="p-t">
      <div class="row"><label>Overlay text</label><input type="text" id="tx" style="width:100%" placeholder="Type a caption…"></div>
      <div id="ts"></div>
      <div class="row"><label>Colour</label><input type="color" id="tc" value="#ffffff"></div>
    </div>
    <div class="pane" id="p-e">
      <div class="row"><label>Resolution</label><select id="res" style="width:100%"><option value="0">Source</option><option value="720">720p</option><option value="1080">1080p</option></select></div>
      <div class="row"><label>Quality</label><select id="q" style="width:100%"><option value="2500000">Small (2.5 Mbps)</option><option value="5000000" selected>Balanced (5 Mbps)</option><option value="10000000">High (10 Mbps)</option></select></div>
      <div class="row"><label>Frame rate</label><select id="fps" style="width:100%"><option>24</option><option selected>30</option><option>60</option></select></div>
      <button class="pri" id="go" style="width:100%" disabled>Render trimmed clip</button>
      <div class="prog"><div id="bar"></div></div><div class="note" id="st">Ready. Export plays the trimmed range in real time and records it on-device.</div>
      <a class="dl" id="dl">Download file</a>
    </div>
  </side>
</main>
<div class="tl">
  <div class="ruler" id="ruler"></div>
  <div class="track" id="track"><div class="thumbs" id="th"></div><div class="shade" id="s1"></div><div class="shade" id="s2"></div><div class="sel" id="sel"></div><div class="h" id="hi"></div><div class="h" id="ho"></div><div class="ph" id="ph"></div></div>
</div>
<script>
"use strict";
const $=s=>document.querySelector(s), v=document.createElement("video"), cv=$("#cv"), ctx=cv.getContext("2d");
v.playsInline=true; v.preload="auto";
const S={dur:0,tin:0,tout:0,speed:1,vol:1,exporting:false,f:{},text:{y:85,size:48}};
const FILTERS=[["brightness","Brightness",100,0,200,"%"],["contrast","Contrast",100,0,200,"%"],["saturate","Saturation",100,0,300,"%"],["hue","Hue",0,0,360,"°"],["blur","Blur",0,0,12,"px"],["grayscale","Grayscale",0,0,100,"%"],["sepia","Sepia",0,0,100,"%"],["invert","Invert",0,0,100,"%"]];
const PRESETS={Original:{},Vivid:{contrast:115,saturate:150,brightness:104},Cinematic:{contrast:125,saturate:85,brightness:92,sepia:12,hue:-8},Noir:{grayscale:100,contrast:140,brightness:92},Vintage:{sepia:55,contrast:92,saturate:120,brightness:105},Cool:{hue:-12,saturate:110,brightness:102},Warm:{sepia:22,saturate:125,hue:6},Fade:{contrast:80,brightness:112,saturate:80}};
const fmt=t=>{t=Math.max(0,t||0);const m=Math.floor(t/60);return m+":"+(t%60).toFixed(1).padStart(4,"0")};
function slider(host,id,label,val,min,max,unit,on){
  const d=document.createElement("div");d.className="row";
  d.innerHTML=`<label>${label}<output>${val}${unit}</output></label><input type="range" min="${min}" max="${max}" step="${max<20?0.1:1}" value="${val}">`;
  const r=d.querySelector("input"),o=d.querySelector("output");
  r.oninput=()=>{o.textContent=r.value+unit;on(+r.value)};host.append(d);return{r,o};
}
const fCtl={};
FILTERS.forEach(([k,l,d,mn,mx,u])=>{S.f[k]=d;fCtl[k]=slider($("#fs"),k,l,d,mn,mx,u,x=>{S.f[k]=x;markPreset();paint()})});
slider($("#as"),"speed","Speed",1,0.25,3,"×",x=>{S.speed=x;v.playbackRate=x;upd()});
slider($("#as"),"vol","Volume",100,0,150,"%",x=>{S.vol=x/100;if(gain)gain.gain.value=S.vol});
slider($("#ts"),"ty","Vertical position",85,5,95,"%",x=>{S.text.y=x;paint()});
slider($("#ts"),"tz","Size",48,12,160,"px",x=>{S.text.size=x;paint()});
$("#tx").oninput=paint;$("#tc").oninput=paint;
Object.keys(PRESETS).forEach((n,i)=>{const b=document.createElement("button");b.textContent=n;if(!i)b.className="on";b.onclick=()=>{
  FILTERS.forEach(([k,,d])=>{const val=PRESETS[n][k]??d;S.f[k]=val;fCtl[k].r.value=val;fCtl[k].o.textContent=val+FILTERS.find(f=>f[0]==k)[5]});
  document.querySelectorAll(".presets button").forEach(x=>x.classList.toggle("on",x===b));paint()};$("#presets").append(b)});
function markPreset(){document.querySelectorAll(".presets button").forEach(x=>x.classList.remove("on"))}
const cssFilter=()=>{const f=S.f;return `brightness(${f.brightness}%) contrast(${f.contrast}%) saturate(${f.saturate}%) hue-rotate(${f.hue}deg) blur(${f.blur}px) grayscale(${f.grayscale}%) sepia(${f.sepia}%) invert(${f.invert}%)`};
function paint(){
  if(!v.videoWidth)return;
  ctx.save();ctx.filter=cssFilter();ctx.drawImage(v,0,0,cv.width,cv.height);ctx.restore();
  const t=$("#tx").value.trim();
  if(t){const sz=S.text.size*cv.height/720;ctx.save();ctx.font=`700 ${sz}px Inter,system-ui,sans-serif`;ctx.textAlign="center";ctx.textBaseline="middle";ctx.lineWidth=sz/8;ctx.strokeStyle="rgba(0,0,0,.65)";ctx.lineJoin="round";ctx.fillStyle=$("#tc").value;
    const x=cv.width/2,y=cv.height*S.text.y/100;ctx.strokeText(t,x,y,cv.width*.92);ctx.fillText(t,x,y,cv.width*.92);ctx.restore()}
}
function sizeCanvas(h){const ar=v.videoWidth/v.videoHeight;let H=h||Math.min(v.videoHeight,1080);cv.height=Math.round(H/2)*2;cv.width=Math.round(H*ar/2)*2}
// Audio graph
let ac,gain,dest,srcNode;
function audio(){if(ac)return;ac=new (window.AudioContext||window.webkitAudioContext)();srcNode=ac.createMediaElementSource(v);gain=ac.createGain();gain.gain.value=S.vol;dest=ac.createMediaStreamDestination();srcNode.connect(gain);gain.connect(ac.destination);gain.connect(dest)}
// Loading
function load(f){
  if(!f||!f.type.startsWith("video/"))return;
  v.src=URL.createObjectURL(f);$("#fn").textContent=f.name;
  v.onloadedmetadata=()=>{S.dur=v.duration;S.tin=0;S.tout=v.duration;sizeCanvas();$("#drop").classList.add("hide");
    ["play","setIn","setOut","reset","exp","go"].forEach(i=>$("#"+i).disabled=false);v.currentTime=0;ruler();thumbs(f);upd()};
  v.onseeked=paint;v.onloadeddata=paint;
}
$("#open").onclick=$("#drop").onclick=()=>$("#file").click();
$("#file").onchange=e=>load(e.target.files[0]);
const dp=$("#drop");["dragover","dragenter"].forEach(e=>dp.addEventListener(e,x=>{x.preventDefault();dp.classList.add("over")}));
["dragleave","drop"].forEach(e=>dp.addEventListener(e,x=>{x.preventDefault();dp.classList.remove("over")}));
dp.addEventListener("drop",e=>load(e.dataTransfer.files[0]));
// Timeline
const tr=$("#track"),W=()=>tr.clientWidth,x2t=x=>Math.min(S.dur,Math.max(0,x/W()*S.dur)),t2x=t=>S.dur?t/S.dur*W():0;
function ruler(){const r=$("#ruler");r.innerHTML="";const step=[1,2,5,10,15,30,60,120,300].find(s=>S.dur/s<=12)||600;for(let t=0;t<=S.dur;t+=step){const i=document.createElement("i");i.style.left=t2x(t)+"px";i.textContent=fmt(t).replace(/\.0$/,"");r.append(i)}}
async function thumbs(f){
  const th=$("#th");th.innerHTML="";const tv=document.createElement("video");tv.muted=true;tv.src=URL.createObjectURL(f);
  await new Promise(r=>tv.onloadeddata=r);const n=Math.max(6,Math.round(W()/90)),c=document.createElement("canvas");c.width=160;c.height=90;
  for(let i=0;i<n;i++){tv.currentTime=Math.min(S.dur-.05,(i+.5)/n*S.dur);await new Promise(r=>tv.onseeked=r);c.getContext("2d").drawImage(tv,0,0,160,90);const im=new Image();im.src=c.toDataURL("image/jpeg",.6);th.append(im)}
}
function upd(){
  const a=t2x(S.tin),b=t2x(S.tout),w=W();
  $("#s1").style.cssText=`left:0;width:${a}px`;$("#s2").style.cssText=`left:${b}px;width:${w-b}px`;
  $("#sel").style.cssText=`left:${a}px;width:${b-a}px`;$("#hi").style.left=a+"px";$("#ho").style.left=(b-14)+"px";
  $("#ph").style.left=t2x(v.currentTime)+"px";$("#cur").textContent=fmt(v.currentTime);$("#tot").textContent=fmt(S.dur);
  $("#clip").textContent=fmt((S.tout-S.tin)/S.speed);
}
function drag(el,fn){el.addEventListener("pointerdown",e=>{e.stopPropagation();e.preventDefault();el.setPointerCapture(e.pointerId);const mv=ev=>fn(x2t(ev.clientX-tr.getBoundingClientRect().left));
  const up=()=>{el.removeEventListener("pointermove",mv);el.removeEventListener("pointerup",up)};el.addEventListener("pointermove",mv);el.addEventListener("pointerup",up);mv(e)})}
drag($("#hi"),t=>{S.tin=Math.min(t,S.tout-.1);v.currentTime=S.tin;upd()});
drag($("#ho"),t=>{S.tout=Math.max(t,S.tin+.1);v.currentTime=S.tout;upd()});
tr.addEventListener("pointerdown",e=>{if(!S.dur||e.target.classList.contains("h"))return;const mv=ev=>{v.currentTime=x2t(ev.clientX-tr.getBoundingClientRect().left);upd()};
  tr.setPointerCapture(e.pointerId);const up=()=>{tr.removeEventListener("pointermove",mv);tr.removeEventListener("pointerup",up)};tr.addEventListener("pointermove",mv);tr.addEventListener("pointerup",up);mv(e)});
addEventListener("resize",()=>{if(S.dur){ruler();upd()}});
// Transport
function toggle(){if(!S.dur||S.exporting)return;audio();ac.resume();if(v.paused){if(v.currentTime>=S.tout-.05||v.currentTime<S.tin)v.currentTime=S.tin;v.playbackRate=S.speed;v.play()}else v.pause()}
v.onplay=()=>$("#play").textContent="⏸ Pause";v.onpause=()=>$("#play").textContent="▶ Play";
$("#play").onclick=toggle;
$("#setIn").onclick=()=>{S.tin=Math.min(v.currentTime,S.tout-.1);upd()};
$("#setOut").onclick=()=>{S.tout=Math.max(v.currentTime,S.tin+.1);upd()};
$("#reset").onclick=()=>{S.tin=0;S.tout=S.dur;upd()};
function loop(){
  if(S.dur){
    if(!v.paused){if(v.currentTime>=S.tout){if(!S.exporting){v.pause();v.currentTime=S.tin}}paint()}
    upd();
  }
  requestAnimationFrame(loop);
}
loop();
addEventListener("keydown",e=>{if(/INPUT|SELECT|TEXTAREA/.test(e.target.tagName)||!S.dur)return;
  if(e.code==="Space"){e.preventDefault();toggle()}else if(e.key==="i"||e.key==="I")$("#setIn").click();else if(e.key==="o"||e.key==="O")$("#setOut").click();
  else if(e.key==="ArrowRight"){v.currentTime=Math.min(S.dur,v.currentTime+(e.shiftKey?1:1/30))}else if(e.key==="ArrowLeft"){v.currentTime=Math.max(0,v.currentTime-(e.shiftKey?1:1/30))}});
// Tabs
document.querySelectorAll(".tabs button").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tabs button,.pane").forEach(x=>x.classList.remove("on"));b.classList.add("on");$("#p-"+b.dataset.t).classList.add("on")});
$("#exp").onclick=()=>document.querySelector('[data-t="e"]').click();
// Export
$("#go").onclick=async()=>{
  if(S.exporting)return;
  const type=["video/mp4;codecs=avc1,mp4a.40.2","video/webm;codecs=vp9,opus","video/webm;codecs=vp8,opus","video/webm"].find(t=>window.MediaRecorder&&MediaRecorder.isTypeSupported(t));
  if(!type){$("#st").textContent="This browser doesn’t support MediaRecorder export.";return}
  S.exporting=true;audio();await ac.resume();v.pause();
  const h=+$("#res").value;sizeCanvas(h||undefined);
  const stream=cv.captureStream(+$("#fps").value);dest.stream.getAudioTracks().forEach(t=>stream.addTrack(t));
  const rec=new MediaRecorder(stream,{mimeType:type,videoBitsPerSecond:+$("#q").value}),chunks=[];
  rec.ondataavailable=e=>e.data.size&&chunks.push(e.data);
  v.currentTime=S.tin;await new Promise(r=>{v.onseeked=r});v.onseeked=paint;
  const finish=()=>{rec.stop()};
  rec.onstop=()=>{
    const ext=type.includes("mp4")?"mp4":"webm",blob=new Blob(chunks,{type:type.split(";")[0]}),a=$("#dl");
    a.href=URL.createObjectURL(blob);a.download="frameforge-export."+ext;a.style.display="block";a.textContent=`Download .${ext} (${(blob.size/1048576).toFixed(1)} MB)`;
    $("#st").textContent="Export complete.";$("#bar").style.width="100%";S.exporting=false;v.pause();v.currentTime=S.tin;sizeCanvas();paint();$("#go").disabled=false};
  $("#go").disabled=true;$("#dl").style.display="none";$("#st").textContent="Rendering in real time…";
  rec.start(250);v.playbackRate=S.speed;await v.play();
  const tick=()=>{if(!S.exporting)return;const p=(v.currentTime-S.tin)/(S.tout-S.tin);$("#bar").style.width=Math.min(100,p*100)+"%";
    if(v.currentTime>=S.tout||v.ended){v.pause();finish()}else requestAnimationFrame(tick)};tick();
};
</script>
</body>
</html>
